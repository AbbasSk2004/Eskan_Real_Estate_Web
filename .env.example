// ============================================================
// Public frontend (Next.js) environment variables


// Backend REST API base URL (server-side fetch + client axios share this)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

// WebSocket server URL (client-side only)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

// Storage base URL for uploaded images (derived from NEXT_PUBLIC_API_URL
// if unset, by stripping the /api suffix)
NEXT_PUBLIC_STORAGE_URL=http://localhost:3001/storage

// Public site URL (required for the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

// Google Maps key (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

// Secret that must be passed to /api/revalidate to invalidate ISR cache
REVALIDATION_SECRET=change_me_to_a_long_random_string